{
  "name": "personal-investment-research-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "services:start": "tsx scripts/start-services.ts",
    "worker:agent": "tsx src/agents/worker.ts",
    "mcp:investoday": "tsx src/mcp/investoday-server.ts",
    "demo:start": "docker compose up --build",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "rag:ingest": "tsx scripts/rag-ingest.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:real": "tsx scripts/run-eval.ts --real",
    "eval:stress": "tsx scripts/run-eval.ts --stress",
    "eval:synthetic": "tsx scripts/run-synthetic-eval.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.infra.config.ts",
    "test:watch": "vitest",
    "test:integration:infra": "vitest run --config vitest.infra.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:adopt": "tsx scripts/db-adopt.ts",
    "infra:verify": "tsx scripts/check-infra.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@prisma/client": "^6.12.0",
    "bullmq": "5.81.2",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "ioredis": "5.11.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pg": "8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "18.3.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "postgres-memory-server": "0.3.0",
    "prisma": "^6.12.0",
    "redis-memory-server": "0.17.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
