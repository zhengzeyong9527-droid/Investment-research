generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WatchTarget {
  id         String        @id @default(cuid())
  type       TargetType
  code       String
  name       String
  tags       Json          @default("[]")
  reason     String        @default("")
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  briefItems BriefItem[]
  runs       AnalysisRun[]

  @@unique([type, code])
}

model DailyBrief {
  id          String      @id @default(cuid())
  briefDate   String      @unique
  status      BriefStatus
  windowStart DateTime
  windowEnd   DateTime
  summary     String      @default("")
  generatedAt DateTime    @default(now())
  items       BriefItem[]
  runs        AnalysisRun[]
}

model BriefItem {
  id                String       @id @default(cuid())
  briefId           String
  targetId          String?
  kind              BriefItemKind
  title             String
  source            String
  publishedAt       DateTime
  summary           String
  rawRef            String
  rawPayload        String?
  normalizedPayload String?
  detailText        String       @default("")
  sourceEndpoint    String       @default("")
  fetchedAt         DateTime     @default(now())
  brief             DailyBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  target            WatchTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  runs              AnalysisRun[]
}

model SkillEntry {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  scope       SkillScope
  status      SkillStatus @default(pending)
  runs        AnalysisRun[]
}

model AnalysisRun {
  id           String        @id @default(cuid())
  skillKey     String
  targetId     String?
  briefItemId  String?
  dailyBriefId String?
  status       AnalysisStatus
  inputContext String
  output       String?
  createdAt    DateTime      @default(now())
  skill        SkillEntry    @relation(fields: [skillKey], references: [key])
  target       WatchTarget?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  briefItem    BriefItem?    @relation(fields: [briefItemId], references: [id], onDelete: SetNull)
  dailyBrief   DailyBrief?   @relation(fields: [dailyBriefId], references: [id], onDelete: SetNull)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AgentRun {
  id             String         @id @default(cuid())
  agentKey       String         @default("research-router-agent")
  sessionId      String?
  question       String
  skillKey       String
  triggerType    String         @default("manual")
  status         AgentRunStatus @default(created)
  inputPayload   Json           @default("{}")
  promptPackage  String         @default("")
  outputJson     Json           @default("{}")
  outputMarkdown String?
  model          String         @default("")
  tokenInput     Int            @default(0)
  tokenOutput    Int            @default(0)
  latencyMs      Int            @default(0)
  costCents      Int            @default(0)
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  session        AgentSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messages       AgentMessage[]
  steps          AgentStep[]
  skillRuns      SkillRun[]
  evidence       EvidenceRecord[]
  toolCalls      ToolCall[]
  modelCalls     ModelCall[]
  feedback       UserFeedback[]
  evalResults    AgentEvalResult[]

  @@index([sessionId, status, updatedAt])
  @@index([status, updatedAt])
}

model AgentSession {
  id           String         @id @default(cuid())
  userId       String?
  title        String
  entry        String
  lastActiveAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  runs         AgentRun[]
  messages     AgentMessage[]
  memoryItems  MemoryItem[]
}

model AgentMessage {
  id          String       @id @default(cuid())
  agentRunId  String?
  sessionId   String
  role        String
  content     String
  createdAt   DateTime     @default(now())
  agentRun    AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AgentStep {
  id         String          @id @default(cuid())
  agentRunId String
  nodeKey    String          @default("")
  order      Int
  title      String
  status     AgentStepStatus @default(pending)
  message    String          @default("")
  createdAt  DateTime        @default(now())
  startedAt  DateTime?
  completedAt DateTime?
  agentRun   AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
}

model SkillRun {
  id             String         @id @default(cuid())
  agentRunId     String
  skillKey       String
  skillPath      String
  status         SkillRunStatus @default(pending)
  inputPayload   Json           @default("{}")
  promptPackage  String         @default("")
  outputMarkdown String?
  outputHtml     String?
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  agentRun       AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  evidence       EvidenceRecord[]
}

model EvidenceRecord {
  id             String       @id @default(cuid())
  agentRunId     String
  skillRunId     String?
  toolCallId      String?
  artifactId      String?
  kind           EvidenceKind
  title          String
  source         String
  publishedAt    DateTime?
  summary        String       @default("")
  sourceEndpoint String       @default("")
  rawPayload     Json         @default("{}")
  embedding       Unsupported("vector")?
  fetchedAt      DateTime     @default(now())
  agentRun       AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  skillRun       SkillRun?    @relation(fields: [skillRunId], references: [id], onDelete: SetNull)
  toolCall       ToolCall?    @relation(fields: [toolCallId], references: [id], onDelete: SetNull)
  artifact       ResearchArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([agentRunId, kind, source])
}

model ToolCall {
  id             String       @id @default(cuid())
  agentRunId     String
  toolKey        String
  inputJson      Json         @default("{}")
  outputSummary  String       @default("")
  rawPayloadRef  String?
  status         String
  latencyMs      Int          @default(0)
  error          String?
  sourceEndpoint String       @default("")
  createdAt      DateTime     @default(now())
  agentRun       AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  evidence       EvidenceRecord[]

  @@index([agentRunId, toolKey, status])
}

model ModelCall {
  id          String   @id @default(cuid())
  agentRunId  String
  model       String
  mode        String   @default("markdown")
  promptHash  String   @default("")
  tokenInput  Int      @default(0)
  tokenOutput Int      @default(0)
  costCents   Int      @default(0)
  latencyMs   Int      @default(0)
  status      String
  error       String?
  createdAt   DateTime @default(now())
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, status])
}

model MemoryItem {
  id          String        @id @default(cuid())
  sessionId   String?
  userId      String?
  scope       String
  kind        String
  content     String
  status      String        @default("active")
  importance  Float         @default(0.5)
  lastUsedAt  DateTime?
  hitCount    Int           @default(0)
  embedding   Unsupported("vector")?
  sourceRunId String?
  confidence  Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  session     AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([sessionId, status])
  @@index([kind, status])
}

model ResearchArtifact {
  id          String       @id @default(cuid())
  kind        String
  title       String
  content     String
  source      String
  publishedAt DateTime?
  embedding   Unsupported("vector")?
  createdAt   DateTime     @default(now())
  evidence    EvidenceRecord[]
}

model RagDocument {
  id             String     @id
  title          String
  content        String
  source         String     @default("local")
  sourceUrl      String?
  publishedAt    DateTime?
  licenseStatus  String     @default("internal")
  licenseSource  String     @default("")
  validFrom      DateTime?
  validUntil     DateTime?
  removedAt      DateTime?
  removalReason  String?
  metadata       Json       @default("{}")
  chunkCount     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  chunks         RagChunk[]

  @@index([source])
  @@index([licenseStatus])
  @@index([publishedAt])
  @@index([removedAt])
  @@index([validUntil])
}

model RagChunk {
  id             String       @id
  documentId     String
  title          String
  content        String
  source         String       @default("local")
  sourceUrl      String?
  chunkIndex     Int
  licenseStatus  String       @default("internal")
  licenseSource  String       @default("")
  publishedAt    DateTime?
  validFrom      DateTime?
  validUntil     DateTime?
  removedAt      DateTime?
  metadata       Json         @default("{}")
  embedding      Unsupported("vector")?
  embeddingJson  String       @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  document       RagDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([source])
  @@index([licenseStatus])
  @@index([removedAt])
  @@index([validUntil])
}

model AgentEvalCase {
  id               String            @id @default(cuid())
  agentKey         String
  caseName         String
  inputJson        Json              @default("{}")
  expectedCriteria String            @default("")
  createdAt        DateTime          @default(now())
  results          AgentEvalResult[]
}

model AgentEvalResult {
  id        String        @id @default(cuid())
  caseId    String
  runId     String?
  score     Float         @default(0)
  passed    Boolean       @default(false)
  notes     String        @default("")
  createdAt DateTime      @default(now())
  case      AgentEvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  run       AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
}

model UserFeedback {
  id        String   @id @default(cuid())
  runId     String
  rating    Int
  comment   String   @default("")
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

enum TargetType {
  stock
  sector
}

enum BriefStatus {
  success
  empty
  failed
}

enum BriefItemKind {
  news
  research
  announcement
  event
}

enum SkillScope {
  stock
  sector
  event
  brief
}

enum SkillStatus {
  pending
  enabled
}

enum AnalysisStatus {
  pending
  completed
  failed
}

enum AgentRunStatus {
  created
  queued
  planning
  fetching_data
  running_skill
  interrupted
  completed
  failed
}

enum AgentStepStatus {
  pending
  running
  completed
  failed
}

enum SkillRunStatus {
  pending
  running
  completed
  failed
  skipped
}

enum EvidenceKind {
  news
  research
  announcement
  event
  market
  company
  industry
  raw
}
